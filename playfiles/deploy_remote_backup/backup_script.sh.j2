#!/bin/bash
# This script is auto-generated by Ansible. Do not edit directly on the server.

# --- Variables injected by Ansible ---
DATE=$(date +%Y-%m-%d_%H%M%S)
TEMP_DIR="{{ temp_local_dir }}"
LOG_FILE="{{ backup_log_path }}"
LOCAL_TAR="/storage/backup_$DATE.tar.gz"

REMOTE_HOST="{{ remote_backup_host }}"
REMOTE_USER="{{ remote_backup_user }}"
REMOTE_DIR="{{ remote_backup_dir }}/{{ ansible_hostname }}"

# --- Logic ---

# 0. Clean up from any previous failed run
rm -rf "$TEMP_DIR"
rm -f /storage/backup_*.tar.gz

# 1. Setup Workspace
mkdir -p "$TEMP_DIR/files"
mkdir -p "$TEMP_DIR/metadata"
echo "[$DATE] Starting backup process..." >> "$LOG_FILE"

# 2. Gather Data
echo "Gathering data..." >> "$LOG_FILE"
dpkg --get-selections > "$TEMP_DIR/metadata/installed_packages.txt"
{% for dir in backup_dirs %}
cp -a {{ dir }} "$TEMP_DIR/files/" 2>/dev/null || echo "Warning: {{ dir }} not found" >> "$LOG_FILE"
{% endfor %}

# Pi-hole teleporter backup (if pihole-FTL is installed)
if command -v pihole-FTL &>/dev/null; then
    echo "Creating Pi-hole teleporter backup..." >> "$LOG_FILE"
    (cd "$TEMP_DIR/files" && sudo pihole-FTL --teleporter) && \
        echo "Pi-hole teleporter backup added." >> "$LOG_FILE" || \
        echo "Warning: Pi-hole teleporter command failed" >> "$LOG_FILE"
fi

# 3. Create Tarball
echo "Creating tarball..." >> "$LOG_FILE"
if tar -czf "$LOCAL_TAR" -C "$TEMP_DIR" . ; then
    echo "Local tarball created: $LOCAL_TAR" >> "$LOG_FILE"
else
    echo "ERROR: Tarball creation failed" >> "$LOG_FILE"
    exit 1
fi

# 4. Transfer to Remote Server
echo "Transferring to remote server..." >> "$LOG_FILE"
# Using -o BatchMode=yes ensures we don't hang if the key fails
if sudo -u "$REMOTE_USER" rsync -az -e "ssh -o BatchMode=yes" "$LOCAL_TAR" "$REMOTE_USER@$REMOTE_HOST:$REMOTE_DIR/"; then
    echo "Transfer successful." >> "$LOG_FILE"
else
    echo "ERROR: Transfer failed!" >> "$LOG_FILE"
    rm -rf "$TEMP_DIR"
    rm -f "$LOCAL_TAR"
    exit 1
fi

# 5. VERIFICATION: Check if file exists on remote and has size > 0
echo "Verifying remote file integrity..." >> "$LOG_FILE"
if sudo -u "$REMOTE_USER" ssh -o BatchMode=yes "$REMOTE_USER@$REMOTE_HOST" "[ -s $REMOTE_DIR/$(basename $LOCAL_TAR) ]"; then
    echo "SUCCESS: Remote file verified. Cleaning up local files." >> "$LOG_FILE"
    rm -rf "$TEMP_DIR"
    rm -f "$LOCAL_TAR"

    # 6. Purge old backups on remote, keep last 7
    echo "Purging old backups on remote, keeping last 7..." >> "$LOG_FILE"
    sudo -u "$REMOTE_USER" ssh -o BatchMode=yes "$REMOTE_USER@$REMOTE_HOST" \
        "ls $REMOTE_DIR/backup_*.tar.gz 2>/dev/null | sort | head -n -7 | while read f; do rm -f \"\$f\"; echo \"Removed: \$f\"; done" \
        >> "$LOG_FILE" 2>&1
else
    echo "ERROR: Remote file verification failed! (File missing or empty on remote)" >> "$LOG_FILE"
    rm -rf "$TEMP_DIR"
    rm -f "$LOCAL_TAR"
    exit 1
fi

echo "[$DATE] Backup Complete." >> "$LOG_FILE"
exit 0
